{
  "name": "gutech-lms-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev:demo": "cross-env DEMO_MODE=true tsx watch src/index.ts",
    "start:demo": "cross-env DEMO_MODE=true node dist/index.js",
    "seed:demo": "cross-env DEMO_MODE=true tsx src/demo/cli.ts seed",
    "reset:demo": "cross-env DEMO_MODE=true tsx src/demo/cli.ts reset",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/qs": "^6.15.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supabase": "^2.122.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.74.0"
  }
}
